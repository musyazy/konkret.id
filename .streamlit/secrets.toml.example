# Salin menjadi .streamlit/secrets.toml (JANGAN di-commit) bila memakai MIXDESIGN_AUTH_MODE=google.
# Butuh: pip install "streamlit[auth]>=1.42"  dan kredensial OAuth Google (console.cloud.google.com > APIs & Services > Credentials).
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "ganti-dengan-string-acak-panjang"
client_id = "ID-KLIEN.apps.googleusercontent.com"
client_secret = "RAHASIA-KLIEN"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
